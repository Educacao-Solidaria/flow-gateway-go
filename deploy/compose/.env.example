# Copie para .env (fora do git) e preencha: o compose recusa subir com qualquer uma vazia.
# Cada container recebe só a sua, sem env_file.

# Senha do papel `brain` do banco. Ela vai dentro do DATABASE_URL do RAG: use só caracteres de
# URL (ex.: `openssl rand -hex 24`). Trocá-la depois da 1ª partida não muda a do banco, que
# fica guardada no volume pg-data.
POSTGRES_PASSWORD=
# Chaves da OpenRouter do RAG (embeddings) e do gateway (chat); podem ser a mesma.
OPENROUTER_API_KEY=
FLOW_OPENROUTER_API_KEY=
